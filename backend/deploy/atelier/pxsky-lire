#!/usr/bin/env python3
"""pxsky-lire : l'accès de l'atelier à pxsky, en lecture seule.

Les agents de l'atelier (Claude Code, utilisateur « atelier ») l'appellent par
sudo, sans pouvoir lire les identifiants : ils sont dans /etc/atelier/pxsky.env,
lisible par root seulement, posé par Mathias lui-même. Ce programme se connecte
avec, garde le jeton de session en cache, et ne fait QUE des GET sur l'API de
pxsky (/core/api/v1/…). Il n'affiche jamais ni le mot de passe ni le jeton.

Usage : sudo pxsky-lire <chemin> [clé=valeur ...]
  ex. : sudo pxsky-lire sky/exec/pools
        sudo pxsky-lire sky/exec/jobs activity=contentmanager.csp-build

Deux écritures existent, chacune sous son propre nom (le même programme,
installé trois fois) :
- relancer un import CSP :
    sudo pxsky-relancer-import-csp <jobId>
  POST /core/api/v1/contentmanager/csp-excel/jobs/<jobId>/relaunch ;
- lancer le process CSP d'une airline avec un Excel, lu sur l'entrée
  standard (root n'ouvre aucun chemin donné par l'atelier) :
    sudo pxsky-lancer-import-csp <nom.xlsx> <projectId> <cycle AAAA-MM> <full|check> < fichier.xlsx
  POST /core/api/v1/contentmanager/csp-excel/upload, le formulaire de l'écran
  « Import CSP » de pxsky. Cerveau ne l'appelle qu'après le clic de Mathias.
Rien d'autre ; chaque écriture est notée dans /var/log/atelier-pxsky.log.
"""

import base64
import datetime
import json
import os
import re
import sys
import time
import uuid
import urllib.error
import urllib.parse
import urllib.request

SECRETS = "/etc/atelier/pxsky.env"
CACHE = "/var/cache/atelier/pxsky.token"
JOURNAL = "/var/log/atelier-pxsky.log"
JOB_OK = re.compile(r"^[A-Za-z0-9_-]{6,64}$")
API = "/core/api/v1/"
MAX_SORTIE = 64_000_000  # certaines listes pèsent des dizaines de Mo : mieux vaut filtrer (project=…)
CHEMIN_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9/_.:%-]*$")
INTERDITS = ("session/login", "session/logout", "logs/")  # connexion, déconnexion, flux sans fin


SENSIBLES = re.compile(r"token|password|passwd|secret|api[_-]?key|authorization|cookie", re.I)


def masquer(v):
    """Aucun jeton ni mot de passe ne sort, même si l'API en renvoie."""
    if isinstance(v, dict):
        return {k: ("***" if SENSIBLES.search(k) and isinstance(x, str) else masquer(x)) for k, x in v.items()}
    if isinstance(v, list):
        return [masquer(x) for x in v]
    return v


def erreur(msg, code=1):
    print(json.dumps({"erreur": msg}, ensure_ascii=False))
    sys.exit(code)


def secrets():
    try:
        vals = {}
        for ligne in open(SECRETS, encoding="utf-8"):
            if "=" in ligne and not ligne.lstrip().startswith("#"):
                k, v = ligne.rstrip("\n").split("=", 1)
                vals[k.strip()] = v
        return vals["PXSKY_URL"].rstrip("/"), vals["PXSKY_USER"], vals["PXSKY_PASSWORD"]
    except FileNotFoundError:
        erreur("identifiants pxsky absents : Mathias doit les enregistrer (voir la procédure)")
    except KeyError as e:
        erreur(f"identifiants pxsky incomplets : {e.args[0]} manquant")


def requete(url, data=None, jeton=None, methode=None, type_contenu="application/json", delai=25):
    req = urllib.request.Request(url, data=data, method=methode or ("POST" if data else "GET"))
    req.add_header("Accept", "application/json")
    if data:
        req.add_header("Content-Type", type_contenu)
    if jeton:
        req.add_header("Authorization", f"Bearer {jeton}")
    return urllib.request.urlopen(req, timeout=delai)


def connexion(base, user, mdp):
    corps = json.dumps({"username": user, "password": mdp}).encode()
    try:
        with requete(base + API + "session/login", data=corps) as r:
            jeton = json.load(r).get("token", "")
    except urllib.error.HTTPError as e:
        erreur("connexion à pxsky refusée (identifiants invalides ?)" if e.code == 401 else f"connexion à pxsky : HTTP {e.code}")
    except urllib.error.URLError as e:
        erreur(f"pxsky injoignable : {e.reason}")
    if not jeton:
        erreur("pxsky n'a pas rendu de jeton")
    os.makedirs(os.path.dirname(CACHE), mode=0o700, exist_ok=True)
    fd = os.open(CACHE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(jeton)
    return jeton


def expire(jeton, marge=60):
    """Le jeton est un JWT : on lit sa date d'expiration plutôt que d'attendre
    le refus de pxsky."""
    try:
        charge = jeton.split(".")[1]
        exp = json.loads(base64.urlsafe_b64decode(charge + "=" * (-len(charge) % 4))).get("exp")
        return bool(exp) and exp - marge < time.time()
    except (IndexError, ValueError):
        return False


def jeton_cache():
    try:
        jeton = open(CACHE).read().strip() or None
    except OSError:
        return None
    return None if jeton and expire(jeton) else jeton


def session_perimee(e, detail):
    """pxsky refuse un jeton périmé en 401, ou en 500 avec « token is
    expired » : dans les deux cas, on se reconnecte."""
    return e.code == 401 or (e.code == 500 and re.search(r"token is (expired|invalid)|invalid token", detail, re.I))


def appeler(base, user, mdp, url, methode="GET", corps=None, type_contenu="application/json"):
    """Fait l'appel avec le jeton en cache ; se reconnecte une fois s'il a expiré."""
    jeton = jeton_cache()
    for essai in range(2):
        if not jeton:
            jeton = connexion(base, user, mdp)
        try:
            data = corps if corps is not None else (b"" if methode == "POST" else None)
            with requete(url, data=data, jeton=jeton, methode=methode, type_contenu=type_contenu,
                         delai=120 if corps else 25) as r:
                return r.status, r.read(MAX_SORTIE + 1).decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            detail = e.read(500).decode("utf-8", "replace")
            if session_perimee(e, detail) and essai == 0:
                jeton = None  # session expirée : on se reconnecte une fois
                continue
            erreur(f"HTTP {e.code} : {detail}")
        except urllib.error.URLError as e:
            erreur(f"pxsky injoignable : {e.reason}")
    erreur("pxsky refuse la session")


def afficher(corps):
    try:
        corps = json.dumps(masquer(json.loads(corps)), ensure_ascii=False)
    except json.JSONDecodeError:
        corps = re.sub(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+", "***", corps)
    if len(corps) > MAX_SORTIE:
        corps = corps[:MAX_SORTIE] + "\n… (réponse tronquée)"
    print(corps)


def relancer_import(job):
    """La seule écriture : relancer un import CSP déjà existant."""
    if not JOB_OK.match(job):
        erreur("identifiant de job invalide")
    base, user, mdp = secrets()
    statut, corps = appeler(base, user, mdp, f"{base}{API}contentmanager/csp-excel/jobs/{job}/relaunch", methode="POST")
    try:
        with open(JOURNAL, "a", encoding="utf-8") as j:
            j.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} relance import CSP {job} -> HTTP {statut}\n")
    except OSError:
        pass
    afficher(corps)


PROJET_OK = re.compile(r"^[a-f0-9]{24}$")
CYCLE_OK = re.compile(r"^20\d\d-(0[1-9]|1[0-2])$")
NOM_OK = re.compile(r"^[^/\\\x00-\x1f]{1,200}\.xlsx?$", re.I)
EXCEL_MAX = 40_000_000


def journal(ligne):
    try:
        with open(JOURNAL, "a", encoding="utf-8") as j:
            j.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {ligne}\n")
    except OSError:
        pass


def lancer_import(nom, projet, cycle, mode):
    """La seconde écriture : créer le process CSP d'un cycle avec un Excel,
    comme l'écran « Import CSP » de pxsky."""
    if not NOM_OK.match(nom):
        erreur("nom de fichier invalide (un .xlsx, sans chemin)")
    if not PROJET_OK.match(projet):
        erreur("identifiant de projet pxsky invalide")
    if not CYCLE_OK.match(cycle):
        erreur("cycle invalide : AAAA-MM attendu (ex. 2026-12)")
    if mode not in ("full", "check"):
        erreur("mode : full ou check")
    fichier = sys.stdin.buffer.read(EXCEL_MAX + 1)
    if len(fichier) > EXCEL_MAX:
        erreur("Excel trop lourd")
    if not fichier.startswith(b"PK") and not fichier.startswith(b"\xd0\xcf\x11\xe0"):
        erreur("ce n'est pas un fichier Excel")
    sep = uuid.uuid4().hex
    parties = []
    for cle, val in (("projectId", projet), ("cycle", cycle), ("mode", mode)):
        parties.append(f'--{sep}\r\nContent-Disposition: form-data; name="{cle}"\r\n\r\n{val}\r\n'.encode())
    nom_entete = nom.replace('"', "'")
    parties.append(f'--{sep}\r\nContent-Disposition: form-data; name="file"; filename="{nom_entete}"\r\n'
                   f"Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\r\n\r\n".encode()
                   + fichier + b"\r\n")
    parties.append(f"--{sep}--\r\n".encode())
    base, user, mdp = secrets()
    journal(f"lancement import CSP {nom} projet={projet} cycle={cycle} mode={mode} ({len(fichier)} octets)")
    statut, corps = appeler(base, user, mdp, f"{base}{API}contentmanager/csp-excel/upload", methode="POST",
                            corps=b"".join(parties), type_contenu=f"multipart/form-data; boundary={sep}")
    journal(f"lancement import CSP {nom} -> HTTP {statut} {corps[:200]}")
    afficher(corps)


def main():
    if os.path.basename(sys.argv[0]) == "pxsky-lancer-import-csp":
        if len(sys.argv) != 5:
            erreur("usage : pxsky-lancer-import-csp <nom.xlsx> <projectId> <cycle> <full|check> < fichier.xlsx")
        lancer_import(sys.argv[1].strip(), sys.argv[2].strip(), sys.argv[3].strip(), sys.argv[4].strip())
        return
    if os.path.basename(sys.argv[0]) == "pxsky-relancer-import-csp":
        if len(sys.argv) != 2:
            erreur("usage : pxsky-relancer-import-csp <jobId>")
        relancer_import(sys.argv[1].strip())
        return
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    chemin = sys.argv[1].strip().lstrip("/")
    if chemin.startswith("core/api/v1/"):
        chemin = chemin[len("core/api/v1/"):]
    if not CHEMIN_OK.match(chemin) or ".." in chemin or any(i in chemin for i in INTERDITS):
        erreur("chemin refusé : uniquement des lectures sur l'API pxsky, ex. sky/exec/pools")
    params = []
    for a in sys.argv[2:]:
        if "=" not in a:
            erreur(f"paramètre invalide : {a} (attendu clé=valeur)")
        params.append(tuple(a.split("=", 1)))
    base, user, mdp = secrets()
    url = base + API + chemin + ("?" + urllib.parse.urlencode(params) if params else "")
    afficher(appeler(base, user, mdp, url)[1])


if __name__ == "__main__":
    main()
