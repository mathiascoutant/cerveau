; Unité systemd pour le VPS OVH.
; Installation :
;   sudo cp deploy/cerveau.service /etc/systemd/system/
;   sudo systemctl daemon-reload && sudo systemctl enable --now cerveau
[Unit]
Description=Cerveau — API de l'assistant Raoul
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cerveau
Group=cerveau
WorkingDirectory=/opt/cerveau
EnvironmentFile=/opt/cerveau/.env
ExecStart=/opt/cerveau/cerveau
Restart=always
RestartSec=5

; Durcissement : le service n'a besoin ni du disque ni de privilèges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cerveau

[Install]
WantedBy=multi-user.target
