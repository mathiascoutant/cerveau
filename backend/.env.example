# ---- Serveur ----------------------------------------------------------------
ADDR=:8080
DEFAULT_TIMEZONE=Europe/Paris

# Prénom utilisé par Raoul tant qu'aucun n'est enregistré depuis l'app.
DEFAULT_USER_NAME=

# ---- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/?appName=cerveau
MONGO_DB=cerveau

# ---- Chiffrement des secrets utilisateurs -----------------------------------
# À générer UNE fois puis à ne jamais changer : openssl rand -hex 32
# Si tu la perds, toutes les connexions (Gandi/Slack/WhatsApp) sont à refaire.
MASTER_KEY=

# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# gpt-5.4-mini : rapide et économique, tient l'enchaînement d'outils.
# gpt-5.4-nano existe et coûte moins cher, mais cale sur le raisonnement multi-étapes.
OPENAI_MODEL=gpt-5.4-mini
# none | minimal | low | medium | high — « low » = bon compromis latence/qualité en vocal
OPENAI_EFFORT=low

# ---- Slack OAuth (optionnel mais recommandé) --------------------------------
# Évite de copier-coller un token xoxp- à la main : l'app ouvre la page de
# consentement Slack et le token revient chiffré en base.
# api.slack.com/apps > ton app > Basic Information > App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# URL publique du backend, utilisée pour construire le redirect_uri OAuth.
# À déclarer à l'identique dans Slack > OAuth & Permissions > Redirect URLs :
#   https://cerveau.neurorun.fr/oauth/slack/callback
PUBLIC_BASE_URL=https://cerveau.neurorun.fr

# ---- WhatsApp Business Cloud API (Meta) -------------------------------------
# Chaîne que TU choisis, à recopier à l'identique dans la config du webhook Meta.
WHATSAPP_VERIFY_TOKEN=
# Meta > Paramètres de l'app > Clé secrète. Sert à valider la signature du webhook.
WHATSAPP_APP_SECRET=

# ---- Transcription serveur (optionnel) --------------------------------------
# Laisser vide : l'app iOS utilise la reconnaissance vocale native (gratuite, on-device).
# Ne remplir que pour le mode de secours /assistant/voice — la même clé OpenAI
# que ci-dessus fait l'affaire, une seule facture.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
